NODE_ENV=development
PORT=5001
DATABASE_URL=mongodb://localhost:27017/moeb26

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
JWT_EXPIRE_IN=1d
JWT_REFRESH_EXPIRE_IN=30d

# Prefer a restricted key (rk_test_...) with PaymentIntents write and Refunds write.
STRIPE_SECRET_KEY=sk_test_placeholder
# Signing secret of the webhook endpoint, or the one `stripe listen` prints locally.
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# true: new bookings start PENDING and must be paid through Stripe (spec 0002).
PAYMENTS_ENABLED=false
GOOGLE_CLIENT_ID=placeholder
FIREBASE_PROJECT_ID=placeholder
