generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  OPERATOR
  ADMIN
}

enum AccountStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
  LOCKED
  DEACTIVATED
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  email               String          @unique
  passwordHash        String
  name                String
  phoneNumber         String?
  role                Role            @default(USER)
  status              AccountStatus   @default(UNVERIFIED)
  isEmailVerified     Boolean         @default(false)
  isRootAdmin         Boolean         @default(false)
  deletedAt           DateTime?
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sessions            Session[]
  mfaCredential       MfaCredential?
  verificationTokens  VerificationToken[]
  operatorProfile     OperatorProfile?
  bookings            Booking[]
  requestedRefunds    Refund[]
  bookingRequests     BookingRequest[] @relation("BookingRequestRequestedBy")
  resolvedRequests    BookingRequest[] @relation("BookingRequestResolvedBy")
  bookingChanges      BookingChange[]
}

model OperatorProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  contactPersonName String
  contactEmail      String?
  businessAddress   String?
  /// Public URL of the company logo (uploaded from operator settings); null = no logo.
  logoUrl           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ferries           Ferry[]
  offDays           OffDay[]
}

model MfaCredential {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted String
  isEnabled       Boolean  @default(false)
  enabledAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  tokenVersion     Int       @default(1)
  deviceInfo       String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}


model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    // Hashed token for security
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

model Port {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departureRoutes   Route[] @relation("DeparturePort")
  destinationRoutes Route[] @relation("DestinationPort")
}

/// A platform route between two ports, managed by admins. Operators run trips on it by
/// scheduling their own ferries; the trip's operator is the ferry's operator.
model Route {
  id                String          @id @default(uuid()) @db.Uuid
  departurePortId   String          @db.Uuid
  departurePort     Port            @relation("DeparturePort", fields: [departurePortId], references: [id], onDelete: Restrict)
  destinationPortId String          @db.Uuid
  destinationPort   Port            @relation("DestinationPort", fields: [destinationPortId], references: [id], onDelete: Restrict)
  durationMinutes   Int
  basePrice         Float?          @default(30)
  description       String?
  amenities         String[]        @default([])
  imageUrl          String?
  isBorderCrossing  Boolean         @default(false)
  status            RouteStatus     @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  schedules         Schedule[]
  /// Ferries dedicated to this route (see Ferry.dedicatedRoutes).
  dedicatedFerries  Ferry[]         @relation("FerryDedicatedRoutes")

  @@unique([departurePortId, destinationPortId])
  @@index([departurePortId])
  @@index([destinationPortId])
}

enum VesselType {
  CATAMARAN
  SPEEDBOAT
  TRADITIONAL_FERRY
}

enum VesselStatus {
  IN_SERVICE
  MAINTENANCE
}

enum TripStatus {
  ON_TIME
  PREPARING
  BOARDING
  DEPARTED
  DELAYED
  ARRIVED
  CANCELLED
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
  SAME_DAY_RETURN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  EXPIRED
}

enum BoardingStatus {
  PENDING
  CHECKED_IN
  BOARDED
}

enum CabinClass {
  STANDARD
  BUSINESS
  VIP
}

enum OffDayCategory {
  MAINTENANCE
  WEATHER
  PUBLIC_HOLIDAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELED
}

enum PaymentProvider {
  STRIPE
  MANUAL
  LEGACY_SEED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundReason {
  CUSTOMER_CANCEL
  ADMIN
  TRIP_CANCELLED
  LATE_PAYMENT
}

model Ferry {
  id           String          @id @default(uuid()) @db.Uuid
  operatorId   String          @db.Uuid
  operator     OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int
  type         VesselType      @default(CATAMARAN)
  status       VesselStatus    @default(IN_SERVICE)
  imageUrl     String?
  amenities    String[]        @default([])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  schedules    Schedule[]
  offDays      OffDay[]
  /// Optional. Empty = the ferry may sail any route; otherwise its trips are limited to these routes.
  dedicatedRoutes Route[]     @relation("FerryDedicatedRoutes")

  @@index([operatorId])
}

model Schedule {
  id             String      @id @default(uuid()) @db.Uuid
  routeId        String      @db.Uuid
  route          Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  ferryId        String      @db.Uuid
  ferry          Ferry       @relation(fields: [ferryId], references: [id], onDelete: Restrict)
  departureTime  DateTime
  arrivalTime    DateTime
  gate           String?
  captain        String?
  adultFare      Float       @default(0)
  childFare      Float       @default(0)
  /// Bundle fares per passenger for a booking that starts on this trip. null = option not offered.
  adultRoundTripFare Float?
  childRoundTripFare Float?
  adultSameDayFare   Float?
  childSameDayFare   Float?
  status         TripStatus  @default(ON_TIME)
  availableSeats Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  bookings       Booking[]
  returnBookings Booking[]   @relation("ReturnSchedule")
  preferredByRequests       BookingRequest[] @relation("BookingRequestPreferred")
  preferredReturnByRequests BookingRequest[] @relation("BookingRequestPreferredReturn")
  changesFrom    BookingChange[] @relation("BookingChangeFrom")
  changesTo      BookingChange[] @relation("BookingChangeTo")

  @@index([routeId, departureTime])
  @@index([ferryId, departureTime])
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  reference          String        @unique
  userId             String?       @db.Uuid
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  scheduleId         String        @db.Uuid
  schedule           Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  tripType           TripType      @default(ONE_WAY)
  /// Return leg for ROUND_TRIP / SAME_DAY_RETURN; null for ONE_WAY.
  returnScheduleId   String?       @db.Uuid
  returnSchedule     Schedule?     @relation("ReturnSchedule", fields: [returnScheduleId], references: [id], onDelete: Restrict)
  leadPassengerName  String
  leadPassengerEmail String
  leadPassengerPhone String?
  adultsCount        Int           @default(1)
  childrenCount      Int           @default(0)
  totalAmount        Float
  status             BookingStatus @default(CONFIRMED)
  holdExpiresAt      DateTime?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  expiredAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tickets            Ticket[]
  payment            Payment?
  requests           BookingRequest[]
  changes            BookingChange[]

  @@index([userId])
  @@index([scheduleId])
  @@index([returnScheduleId])
  @@index([reference])
  @@index([status, holdExpiresAt])
}

enum BookingRequestType {
  CANCEL
  RESCHEDULE
}

enum BookingRequestStatus {
  PENDING
  CANCELLED
  RESCHEDULED
  REJECTED
  WITHDRAWN
}

enum BookingLeg {
  OUTBOUND
  RETURN
}

/// Spec 0004: a customer's cancel or reschedule ask inside the 24h window, resolved by staff.
/// At most one PENDING per booking (partial unique index in the migration).
model BookingRequest {
  id                        String               @id @default(uuid()) @db.Uuid
  bookingId                 String               @db.Uuid
  booking                   Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type                      BookingRequestType
  status                    BookingRequestStatus @default(PENDING)
  /// null = whole booking; RETURN for a CHECKED_IN booking's return only request.
  leg                       BookingLeg?
  reason                    String?
  preferredScheduleId       String?              @db.Uuid
  preferredSchedule         Schedule?            @relation("BookingRequestPreferred", fields: [preferredScheduleId], references: [id], onDelete: SetNull)
  preferredReturnScheduleId String?              @db.Uuid
  preferredReturnSchedule   Schedule?            @relation("BookingRequestPreferredReturn", fields: [preferredReturnScheduleId], references: [id], onDelete: SetNull)
  requestedByUserId         String?              @db.Uuid
  requestedBy               User?                @relation("BookingRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  resolvedByUserId          String?              @db.Uuid
  resolvedBy                User?                @relation("BookingRequestResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt                DateTime?
  staffNote                 String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  changes                   BookingChange[]

  @@index([bookingId, status])
  @@index([status, createdAt])
}

/// Spec 0004: one row per leg moved to another trip. Never edited.
model BookingChange {
  id              String          @id @default(uuid()) @db.Uuid
  bookingId       String          @db.Uuid
  booking         Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  leg             BookingLeg
  fromScheduleId  String          @db.Uuid
  fromSchedule    Schedule        @relation("BookingChangeFrom", fields: [fromScheduleId], references: [id], onDelete: Restrict)
  toScheduleId    String          @db.Uuid
  toSchedule      Schedule        @relation("BookingChangeTo", fields: [toScheduleId], references: [id], onDelete: Restrict)
  requestId       String?         @db.Uuid
  request         BookingRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  changedByUserId String?         @db.Uuid
  changedBy       User?           @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  reason          String?
  createdAt       DateTime        @default(now())

  @@index([bookingId, createdAt])
}

model Ticket {
  id             String         @id @default(uuid()) @db.Uuid
  bookingId      String         @db.Uuid
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketNumber   String         @unique
  passengerName  String
  nationality    String
  passportOrId   String
  cabinClass     CabinClass     @default(STANDARD)
  luggageCount   Int            @default(0)
  boardingStatus BoardingStatus @default(PENDING)
  boardedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([bookingId])
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  bookingId          String        @unique @db.Uuid
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amountCents             Int
  currency                String          @default("usd")
  commissionRate          Float
  platformCommissionCents Int
  operatorPayoutCents     Int
  provider                PaymentProvider
  stripePaymentIntentId   String?         @unique
  status                  PaymentStatus   @default(PENDING)
  lastFailureCode         String?
  lastFailureMessage      String?
  paymentMethod           String?
  paidAt                  DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  /// Deprecated by spec 0001: no longer read or written. Dropped by the contract migration (scope feature 9).
  transactionId      String?       @unique
  /// Deprecated by spec 0001 (use amountCents).
  amount             Float?
  /// Deprecated by spec 0001 (use platformCommissionCents).
  platformCommission Float?
  /// Deprecated by spec 0001 (use operatorPayoutCents).
  operatorPayout     Float?

  refunds            Refund[]
  webhookEvents      StripeWebhookEvent[]
}

model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @db.Uuid
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents       Int
  status            RefundStatus @default(PENDING)
  reason            RefundReason
  stripeRefundId    String?      @unique
  requestedByUserId String?      @db.Uuid
  requestedBy       User?        @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  failureMessage    String?
  createdAt         DateTime     @default(now())
  processedAt       DateTime?

  @@index([paymentId])
}

/// Stripe events already received, keyed by the Stripe event id so a replayed webhook is applied once.
model StripeWebhookEvent {
  id          String    @id
  type        String
  paymentId   String?   @db.Uuid
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  /// Last processing error for this event; cleared on a later successful pass (spec 0002, AC-11).
  error       String?

  @@index([paymentId])
}

model OffDay {
  id         String          @id @default(uuid()) @db.Uuid
  operatorId String          @db.Uuid
  operator   OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  ferryId    String?         @db.Uuid
  ferry      Ferry?          @relation(fields: [ferryId], references: [id], onDelete: Cascade)
  date       DateTime
  reason     String
  category   OffDayCategory  @default(MAINTENANCE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([operatorId, date])
}

model PlatformSetting {
  id             String   @id @default(uuid()) @db.Uuid
  platformName   String   @default("FerryGo")
  supportEmail   String   @default("support@ferrygo.com")
  commissionRate Float    @default(10.0)
  payoutSchedule String   @default("WEEKLY")
  seatHoldMinutes Int     @default(15)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Faq {
  id          String   @id @default(uuid()) @db.Uuid
  question    String
  answer      String   @db.Text
  category    String   @default("Booking")
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([order])
}

model LegalPage {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  content     String   @db.Text
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}
